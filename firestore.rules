rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return true; // SaaS Admin Control
    }

    // System Settings & Branding
    match /settings/{docId} {
      allow read, write: if true;
    }

    match /system/{docId} {
      allow read, write: if true;
    }

    // Tenants / Organizations
    match /tenants/{tenantId} {
      allow read, write: if true;
    }

    match /organizations/{orgId} {
      allow read, write: if true;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Subscription Packages
    match /packages/{packageId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Direct access collections for features
    match /receipts/{receiptId} {
      allow read, write: if true;
    }

    match /receipt_templates/{templateId} {
      allow read, write: if true;
    }

    match /invoice_history/{invoiceId} {
      allow read, write: if true;
    }

    match /print_logs/{logId} {
      allow read, write: if true;
    }

    match /daily_collections/{colId} {
      allow read, write: if true;
    }

    match /transactions/{txnId} {
      allow read, write: if true;
    }

    match /dues/{dueId} {
      allow read, write: if true;
    }

    match /payment_history/{payId} {
      allow read, write: if true;
    }

    match /sms_logs/{logId} {
      allow read, write: if true;
    }

    match /notification_logs/{id} {
      allow read, write: if true;
    }

    match /message_templates/{templateId} {
      allow read, write: if true;
    }

    match /push_notifications/{id} {
      allow read, write: if true;
    }

    match /communication_settings/{id} {
      allow read, write: if true;
    }

    match /income/{id} {
      allow read, write: if true;
    }

    match /expenses/{id} {
      allow read, write: if true;
    }

    match /cashbook/{id} {
      allow read, write: if true;
    }

    match /bank_accounts/{id} {
      allow read, write: if true;
    }

    match /bank_transactions/{id} {
      allow read, write: if true;
    }

    match /ledgers/{id} {
      allow read, write: if true;
    }

    match /financial_reports/{id} {
      allow read, write: if true;
    }

    match /income_categories/{id} {
      allow read, write: if true;
    }

    match /expense_categories/{id} {
      allow read, write: if true;
    }

    match /analytics/{id} {
      allow read, write: if true;
    }

    match /report_cache/{id} {
      allow read, write: if true;
    }

    match /dashboard_widgets/{id} {
      allow read, write: if true;
    }

    match /api_keys/{keyId} {
      allow read, write: if true;
    }

    match /api_logs/{logId} {
      allow read, write: if true;
    }

    match /api_usage/{usageId} {
      allow read, write: if true;
    }

    match /mobile_sessions/{sessionId} {
      allow read, write: if true;
    }

    match /profile_updates/{updateId} {
      allow read, write: if true;
    }
  }
}
